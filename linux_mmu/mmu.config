# config fragment : MMU Linux (S-mode, OpenSBI) on top of the nommu .config
# CONFIG_RISCV_M_MODE is not set
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_EFI is not set
# CONFIG_RELOCATABLE is not set
# STRICT_KERNEL_RWX off : on RV32 it aligns the sections to 4MB (a 21MB Image)
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_RISCV_SBI=y
CONFIG_RISCV_TIMER=y
# CONFIG_CLINT_TIMER is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_MYUART=y
CONFIG_SERIAL_MYUART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
