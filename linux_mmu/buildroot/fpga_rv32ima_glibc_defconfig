# Buildroot (2026.08.2) : userland for the MMU Linux on my-riscv-rv32i-dc
#   RV32IMA (no F / D / C), ilp32 (soft float), glibc, bash as /bin/sh,
#   initramfs (rootfs.cpio) embedded in the kernel of ../build.sh (CPIO=...)
#   The kernel and OpenSBI are not built here.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVC is not set
BR2_RISCV_32=y
BR2_RISCV_ABI_ILP32=y
# toolchain : built by Buildroot, glibc; headers not newer than the kernel (7.0)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_18=y
# system
BR2_TARGET_GENERIC_HOSTNAME="fpga-rv32"
BR2_TARGET_GENERIC_ISSUE="my-riscv-rv32i-dc : Buildroot (glibc, bash)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_SYSTEM_BIN_SH_BASH=y
# packages (busybox : the default, for the small commands; SHOW_OTHERS : bash is
# hidden without it)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
# filesystem : initramfs only
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set
