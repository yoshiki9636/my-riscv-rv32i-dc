`ifndef FPGA_CONFIG_VH
`define FPGA_CONFIG_VH

// ---- board select (choose one) ----
//   BOARD_ARTY_A7 : Arty A7  rst_n (active low); MEM_MIG: rgb_led0-3, gpio[7:0], SPI pins / MEM_QSPI: rgb_led0, gpio[5:0]
//                   clk_wiz_0 : MEM_MIG: clk_out1 = 200MHz (MIG ref), clk_out2 = clk (50MHz) / MEM_QSPI: clk_out1 = clk (50MHz) only
//   BOARD_CMOD_A7 : CMOD A7  rst_p (active high), rgb_led0, gpio[3:0], no SPI pins
//                   clk_wiz_0 : clk_out1 = clk (48MHz)
//   BOARD_TANG_PRIMER_25K : Tang Primer 25K (GW5A-LV25MG121) + SDRAM module
//                   rst_p, rgb_led[2:0], gpio[2:0], SPI pins, init_uart_pin (1 pin), sdram_cs[1:0], no rx2/tx2, no init_cpu_start pin
//                   Gowin PLL (see TANG_PLL_* below) / pins : syn/lab6_tang_sdram_io_pins.cst
//`define BOARD_ARTY_A7
//`define BOARD_CMOD_A7
`define BOARD_TANG_PRIMER_25K

// ---- main memory select (choose one) ----
//   MEM_MIG   : DDR3 via MIG (Arty A7 only)
//   MEM_QSPI  : QSPI PSRAM via qspi_if
//   MEM_SDRAM : SDR SDRAM via sdram_if (Tang Primer 25K only)
//`define MEM_MIG
//`define MEM_QSPI
`define MEM_SDRAM

// ---- Tang Primer 25K PLL select (choose one) ----
//   The PLL is generated by Gowin IP Core Generator (PLL, clkin 50MHz).
//   Generate the module with the name of FT_PLL_MODULE and the clock outputs below.
//     clkout0 : mclk (SDRAM controller / dram_top memory side, also the SDRAM
//               chip clock : sdram_clk = mclk, 0deg, no phase shift)
//     clkout1 : clk  (CPU / bus)
//     reset   : enable (active high), lock : enable
//     mdclk   : (GW5A PLL IP) clock of the PLL init logic : clkin is connected
//   FT_PLL_NO_LOCK : define when the PLL IP has no lock / reset ports
//     (locked is made by a wait counter : 2^FT_PLL_WAIT_W clkin cycles)
//   FT_MCLK_MHZ is used for the SDRAM timing calculation (integer MHz).
//   FT_SDRAM_CAS_LAT / FT_SDRAM_RD_LAT : CAS latency / READ command -> read data
//     capture (mclk cycles, = CAS_LAT + 1, see sdram_if.v)
//   FT_SDRAM_OUT_NEGEDGE : 1 : SDRAM output pins are driven at negedge mclk
//     (setup / hold about T/2 without clock phase adjustment, see sdram_if.v)
//   FT_UART_TERM_* : uart_term reset value (= clk / bps) selected by init_uart pins
//
//   TANG_PLL_50M : mclk 50MHz, clk 50MHz
//                  (clk does not meet timing on GW5A-25 : Fmax about 39MHz)
//   TANG_PLL_33M : mclk 50MHz, clk 33.33MHz (= 50MHz x 2 / 3)
//                  PLL : clkout0 50MHz, clkout1 33.333MHz
//                  Linux dts : timebase-frequency = <33333333> (FRC runs on clk)
//`define TANG_PLL_50M
`define TANG_PLL_33M

`ifdef TANG_PLL_50M
  `define FT_PLL_MODULE Gowin_PLL
  `define FT_PLL_NO_LOCK          // Gowin_PLL : clkin, clkout0, clkout1, mdclk only
  `define FT_PLL_WAIT_W 17        // 2^17 / 50MHz = 2.6ms
  `define FT_MCLK_MHZ 50
  `define FT_SDRAM_CAS_LAT 2
  `define FT_SDRAM_RD_LAT 3
  `define FT_SDRAM_OUT_NEGEDGE 1 // SDRAM output pins change at negedge mclk (see sdram_if.v)
  `define FT_UART_TERM_921600 16'd54  // 50MHz / 921600
  `define FT_UART_TERM_115200 16'd434 // 50MHz / 115200
`endif

`ifdef TANG_PLL_33M
  `define FT_PLL_MODULE Gowin_PLL
  `define FT_PLL_NO_LOCK          // Gowin_PLL : clkin, clkout0, clkout1, mdclk only
  `define FT_PLL_WAIT_W 17        // 2^17 / 50MHz (clkin) = 2.6ms
  `define FT_MCLK_MHZ 50          // mclk is 50MHz : SDRAM timing is the same as TANG_PLL_50M
  `define FT_SDRAM_CAS_LAT 2
  `define FT_SDRAM_RD_LAT 3
  `define FT_SDRAM_OUT_NEGEDGE 1
  `define FT_UART_TERM_921600 16'd36  // 33.333MHz / 921600 = 36.17 (-0.5%)
  `define FT_UART_TERM_115200 16'd289 // 33.333MHz / 115200 = 289.35 (-0.1%)
`endif

// Tang Primer 25K has no init_cpu_start pin : fixed value
//   (init_uart_pin = init_uart[1] is an external pin : see io_uart_out.v / syn/lab6_tang_sdram_io_pins.cst)
`define FT_TANG_INIT_CPU_START 1'b0

`endif // FPGA_CONFIG_VH
